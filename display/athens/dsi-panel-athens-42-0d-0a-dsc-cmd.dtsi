&mdss_mdp {
	dsi_athens_42_0d_0a_dsc_cmd: qcom,mdss_dsi_athens_42_0d_0a_dsc_cmd {
		qcom,mdss-dsi-panel-name = "xiaomi athens 42 0d 0a cmd mode dsc dsi panel";
		qcom,mdss-dsi-panel-type = "dsi_cmd_mode";
