					/* PMIC 1 */
					39 00 00 40 00 00 02 72 00
					05 00 00 00 78 00 01 11
					05 00 00 00 00 00 01 29
					/* Error flag optimization */
					39 00 00 40 00 00 03 F0 AA 10
					39 00 00 40 00 00 02 65 01
					39 00 00 40 00 00 02 CF 87
					/* dummy setting */
					39 00 00 40 00 00 03 F0 AA 10
					39 00 00 40 00 00 02 65 04
					39 00 00 40 00 00 02 B0 02
					/* cover AOD problem */
					39 00 00 40 00 00 03 F0 AA 12
					39 00 00 40 00 00 02 65 02
					39 00 00 40 00 00 02 D1 00
					39 00 00 40 00 00 03 F0 AA 10
					39 00 00 40 00 00 02 65 09
