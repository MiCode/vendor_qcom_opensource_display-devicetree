					39 00 00 40 00 00 02 65 28
					39 00 00 40 00 00 04 EA 0C 00 00
					39 00 00 40 00 00 02 65 0A
					39 00 00 00 00 00 02 EB 10
					/* err flag */
					39 00 00 40 00 00 03 F0 AA 10
					39 00 00 40 00 00 02 65 04
					39 00 00 40 00 00 02 C7 03
					39 00 00 40 00 00 02 65 01
					39 00 00 00 00 00 02 CF 02
					/* reload gamma */
					39 00 00 40 00 00 02 59 09
					39 00 00 40 00 00 03 F0 AA 10
					39 00 00 40 00 00 04 EB 00 00 30
					39 00 00 00 00 00 05 EA 0F 41 00 88
					/* ON/OFF function */
					39 00 00 40 00 00 03 F0 AA 11
					39 00 00 40 00 00 02 C3 31
					39 00 00 40 00 00 03 F0 AA 19
					39 00 00 40 00 00 02 D0 11
					39 00 00 40 00 00 03 F0 AA 19
					39 00 00 40 00 00 02 C0 E0
					39 00 00 40 00 00 03 F0 AA 1A
					39 00 00 40 00 00 02 B0 01
					/* OD and DMR by V clr */
					39 00 00 40 00 00 03 FF 5A 83
					39 00 00 40 00 00 02 65 0B
					39 00 00 40 00 00 02 F8 05
					/* soft vglr */
					39 00 00 40 00 00 03 FF 5A 81
					39 00 00 40 00 00 02 65 05
					39 00 00 40 00 00 02 F4 20
					39 00 00 40 00 00 03 FF 5A 81
					39 00 00 40 00 00 02 65 02
					39 00 00 00 00 00 02 FB 53
					/* Save power consumption */
					39 00 00 40 00 00 03 FF 5A 81
					39 00 00 40 00 00 02 65 03
					39 00 00 40 00 00 02 F3 04
					39 00 00 40 00 00 02 65 05
					39 00 00 40 00 00 02 F3 48
					/* upls lp11 mipi err */
					39 00 00 40 00 00 03 FF 5A 80
					39 00 00 40 00 00 02 65 0E
					39 00 00 40 00 00 02 F9 A1
					/* follow P2 black code */
					39 00 00 40 00 00 03 FF 5A 80
					39 00 00 40 00 00 02 65 0F
					39 00 00 40 00 00 02 F9 53
					/* normal setting */
					39 00 00 40 00 00 02 03 01
					39 00 00 40 00 00 02 35 00
					39 00 00 40 00 00 02 53 20
					39 00 00 40 00 00 03 51 00 00
					39 00 00 40 00 00 02 6B 00
					39 00 00 40 00 00 02 6F 02
					39 00 00 40 00 00 02 6C 00
					39 00 00 40 00 00 02 5E 00
					39 00 00 40 00 00 02 6D 00
					/* vesa setting */
