			timing@wqhd_normal_60hz_index_00 {
				#include "dsi-panel-athens-42-0d-0a-dsc-cmd-common.dtsi"
				cell-index = <1>;
				qcom,mdss-dsi-panel-framerate = <60>;
				qcom,mdss-dsi-h-sync-skew = <0>;
				qcom,mdss-dsi-nolp-command = [
					05 00 00 00 00 00 01 38
					39 00 00 00 00 00 03 51 00 23
					//60hz
					15 00 00 00 00 00 02 6C 01
				];
				qcom,mdss-dsi-nolp-command-update = <0x51 1 2>;
				qcom,mdss-dsi-nolp-command-state = "dsi_hs_mode";
				qcom,mdss-dsi-timing-switch-command = [
					//60hz
					39 00 00 40 00 00 02 6C 01
					39 00 00 40 00 00 02 5E 00
					39 00 00 00 00 00 03 F0 AA 00
				];
				qcom,mdss-dsi-timing-switch-command-state = "dsi_hs_mode";

				qcom,mdss-dsi-timing-switch-transition-144-fps-command = [
					//from 165Hz/185Hz to 60Hz - add 144Hz
					39 00 00 60 00 00 02 6C 02
					39 00 00 60 00 00 02 5E 00
					39 00 00 20 03 00 03 F0 AA 00
					//60hz
					39 00 00 60 00 00 02 6C 01
					39 00 00 60 00 00 02 5E 00
					39 00 00 20 00 00 03 F0 AA 00
				];
				qcom,mdss-dsi-timing-switch-transition-144-fps-command-state = "dsi_hs_mode";

