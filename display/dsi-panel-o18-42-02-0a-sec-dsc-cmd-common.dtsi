qcom,mdss-dsi-off-command = [
	/*PANEL OFF*/
	05 00 00 00 0A 00 01 28
	05 00 00 00 78 00 01 10
];
qcom,mdss-dsi-off-command-state = "dsi_lp_mode";

mi,mdss-dsi-flat-mode-on-command = [
	39 00 00 00 00 00 03 5F 00 40
];
mi,mdss-dsi-flat-mode-on-command-state = "dsi_lp_mode";

mi,mdss-dsi-flat-mode-off-command = [
	39 00 00 00 00 00 03 5F 01 40
];
mi,mdss-dsi-flat-mode-off-command-state = "dsi_lp_mode";

mi,mdss-dsi-doze-hbm-command = [
	/* AOD ON */
	05 00 00 40 00 00 01 39
	39 00 00 40 00 00 02 6F 04
	39 00 00 40 00 00 03 51 3F FF
	39 00 00 40 00 00 02 5A 00
	39 00 00 40 00 00 02 6F 03
	39 00 00 40 00 00 03 35 00 01		
];
mi,mdss-dsi-doze-hbm-command-state = "dsi_hs_mode";

mi,mdss-dsi-doze-lbm-command = [
	/* AOD ON */
	05 00 00 40 00 00 01 39
	39 00 00 40 00 00 02 6F 04
	39 00 00 40 00 00 03 51 05 55
	39 00 00 40 00 00 02 5A 00
	39 00 00 40 00 00 02 6F 03
	39 00 00 40 00 00 03 35 00 01
];
mi,mdss-dsi-doze-lbm-command-state = "dsi_hs_mode";

mi,mdss-dsi-dimmingon-command = [15 00 00 00 00 00 02 53 28];
mi,mdss-dsi-dimmingon-command-state = "dsi_hs_mode";
mi,mdss-dsi-dimmingoff-command = [15 00 00 00 00 00 02 53 20];
mi,mdss-dsi-dimmingoff-command-state = "dsi_hs_mode";

mi,mdss-dsi-round-corner-on-command = [
	/*round on */
	39 00 00 40 00 00 06 F0 55 AA 52 08 07
	15 00 00 00 00 00 02 C0 07
];
mi,mdss-dsi-round-corner-on-command-state = "dsi_hs_mode";

mi,mdss-dsi-round-corner-off-command = [
	/*round off */
	39 00 00 40 00 00 06 F0 55 AA 52 08 07
	15 00 00 00 00 00 02 C0 00
];
mi,mdss-dsi-round-corner-off-command-state = "dsi_hs_mode";

qcom,mdss-dsi-panel-width = <1080>;
qcom,mdss-dsi-panel-height = <2520>;
qcom,mdss-dsi-h-front-porch = <32>;
qcom,mdss-dsi-h-back-porch = <32>;
qcom,mdss-dsi-h-pulse-width = <32>;
qcom,mdss-dsi-v-back-porch = <32>;
qcom,mdss-dsi-v-front-porch = <128>;
qcom,mdss-dsi-v-pulse-width = <24>;
qcom,mdss-dsi-h-sync-pulse = <0>;
qcom,mdss-dsi-h-left-border = <0>;
qcom,mdss-dsi-h-right-border = <0>;
qcom,mdss-dsi-v-top-border = <0>;
qcom,mdss-dsi-v-bottom-border = <0>;
qcom,mdss-dsi-panel-clockrate = <965000000>;
qcom,mdss-dsi-panel-jitter = <0x5 0x1>;
qcom,mdss-mdp-transfer-time-us = <7300>;

/*dsc*/
qcom,compression-mode = "dsc";
qcom,mdss-dsc-version = <0x12>;
qcom,mdss-dsc-scr-version = <0x0>;
qcom,mdss-dsc-slice-height = <20>;
qcom,mdss-dsc-slice-width = <540>;
qcom,mdss-dsc-slice-per-pkt = <2>;
qcom,mdss-dsc-bit-per-component = <10>;
qcom,mdss-dsc-bit-per-pixel = <8>;
qcom,mdss-dsc-block-prediction-enable;
//qcom,src-chroma-format = <1>; // add in each timing node to enable 4:2:2 mode

qcom,mdss-dsi-panel-phy-timings = [00 21 08 08 19 16 09 08 09 02 04 00 1C 0D];
qcom,display-topology = <2 2 1>;
qcom,default-topology-index = <0>;
qcom,panel-roi-alignment = <1080 20 1080 20 1080 20>;
qcom,partial-update-enabled = "single_roi";
